<Window x:Class="SwArena.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="swArena Launcher"
        Height="620" Width="980"
        MinHeight="560" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Background}"
        Foreground="{StaticResource Text}"
        FontFamily="Poppins, Segoe UI"
        TextOptions.TextFormattingMode="Display">
    <Grid>
        <Image Source="Assets/gurubashi-arena-background.png"
               Stretch="UniformToFill"
               HorizontalAlignment="Center"
               VerticalAlignment="Center" />

        <Rectangle Fill="#B80A0908" />
        <Rectangle>
            <Rectangle.Fill>
                <RadialGradientBrush Center="0.5,-0.1" GradientOrigin="0.5,-0.1" RadiusX="0.78" RadiusY="0.72">
                    <GradientStop Color="#35825B27" Offset="0" />
                    <GradientStop Color="#00000000" Offset="0.58" />
                    <GradientStop Color="#52000000" Offset="1" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <Grid Margin="44,28,44,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    BorderBrush="#3F301F"
                    BorderThickness="1"
                    Background="#F70D0C0A"
                    Padding="22,0">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.48" />
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="swarena"
                                   Foreground="{StaticResource Gold}"
                                   FontSize="23"
                                   FontWeight="SemiBold" />
                        <Border Width="1" Height="24" Background="{StaticResource Border}" Margin="22,0" />
                        <TextBlock Text="launcher"
                                   VerticalAlignment="Center"
                                   Foreground="#C7B89E"
                                   FontSize="12" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse x:Name="StatusDot" Width="7" Height="7" Fill="{StaticResource GoldMuted}" Margin="0,0,9,0" />
                        <TextBlock x:Name="ServerStatusText"
                                   Text="checking…"
                                   Foreground="{StaticResource Muted}"
                                   FontSize="11"
                                   FontWeight="Medium" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    Width="720"
                    Margin="0,48,0,42"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BorderBrush="{StaticResource Border}"
                    BorderThickness="1"
                    Background="#F2191713">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="42" ShadowDepth="12" Opacity="0.52" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="68" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="#33291D" BorderThickness="0,0,0,1" Padding="28,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Rectangle Height="1" VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#0076562D" Offset="0" />
                                        <GradientStop Color="#FF76562D" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                            <TextBlock Grid.Column="1"
                                       Text="client update"
                                       Margin="18,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Gold}"
                                       FontSize="20"
                                       FontWeight="Normal" />
                            <Rectangle Grid.Column="2" Height="1" VerticalAlignment="Center">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#FF76562D" Offset="0" />
                                        <GradientStop Color="#0076562D" Offset="1" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="1" Margin="42,34,42,38">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="1.35*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Margin="0,4,38,0" VerticalAlignment="Center">
                            <TextBlock Text="THE ARENA AWAITS"
                                       Foreground="{StaticResource GoldMuted}"
                                       FontSize="10"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Classic combat.&#10;Pure competition."
                                       Margin="0,13,0,14"
                                       Foreground="{StaticResource Text}"
                                       FontSize="28"
                                       FontWeight="SemiBold"
                                       LineHeight="34" />
                            <TextBlock Text="Official swArena files are checked before the game starts."
                                       Foreground="{StaticResource Muted}"
                                       FontSize="12"
                                       LineHeight="19"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Rectangle Grid.Column="1" Width="1" Fill="#3A2E20" />

                        <Grid Grid.Column="2" Margin="38,0,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="CLIENT STATUS"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="10"
                                       FontWeight="Medium" />
                            <TextBlock Grid.Row="1"
                                       x:Name="StatusText"
                                       Text="Preparing…"
                                       Margin="0,10,0,18"
                                       Foreground="{StaticResource Text}"
                                       FontSize="19"
                                       FontWeight="Medium"
                                       TextWrapping="Wrap" />
                            <ProgressBar Grid.Row="2"
                                         x:Name="UpdateProgress"
                                         Minimum="0" Maximum="100" Value="0" />
                            <TextBlock Grid.Row="3"
                                       x:Name="DetailText"
                                       Text=""
                                       MinHeight="48"
                                       Margin="0,10,0,20"
                                       Foreground="{StaticResource Muted}"
                                       FontSize="11"
                                       LineHeight="16"
                                       TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Row="4">
                                <Button x:Name="PlayButton"
                                        Content="updating…"
                                        IsEnabled="False"
                                        Click="PlayButton_Click" />
                                <Button x:Name="RetryButton"
                                        Content="retry"
                                        Visibility="Collapsed"
                                        Margin="0,10,0,0"
                                        Click="RetryButton_Click"
                                        Background="#12110F" />
                                <Button x:Name="ChangeFolderButton"
                                        Content="change game folder"
                                        Margin="0,10,0,0"
                                        Padding="18,8"
                                        FontSize="11"
                                        Click="ChangeFolderButton_Click"
                                        Background="#12110F" />
                                <TextBlock x:Name="GamePathText"
                                           Margin="0,9,0,0"
                                           Foreground="#71695D"
                                           FontSize="9"
                                           TextAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <TextBlock x:Name="VersionText"
                           Text="Launcher"
                           Foreground="#71695D"
                           FontSize="10" />
                <TextBlock Text="personal settings and accounts remain untouched"
                           HorizontalAlignment="Right"
                           Foreground="#71695D"
                           FontSize="10" />
            </Grid>
        </Grid>
    </Grid>
</Window>
